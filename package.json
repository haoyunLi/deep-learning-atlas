{
  "name": "deep-learning-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/validate-content.mjs && tsc -b && node scripts/validate-experience.mjs && node scripts/validate-animations.mjs && node scripts/validate-sandboxes.mjs && node scripts/validate-practice.mjs && node scripts/validate-studio.mjs && vite build",
    "validate:studio": "node scripts/validate-studio.mjs",
    "validate:practice": "node scripts/validate-sandboxes.mjs && node scripts/validate-practice.mjs",
    "validate:animations": "node scripts/validate-animations.mjs",
    "validate:experience": "node scripts/validate-experience.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
